{
  "name": "trackingfy",
  "version": "1.0.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:site",
    "build:site": "node site/build.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:apk": "node build-apk.js",
    "build:apk:release": "node build-apk.js --release",
    "release": "node release.js"
  },
  "private": true,
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "@capgo/background-geolocation": "^8.0.35",
    "@types/leaflet": "^1.9.21",
    "dexie": "^4.4.2",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@tailwindcss/postcss": "^4.1.12",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
