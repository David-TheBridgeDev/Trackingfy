{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/app.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/",
    "!/blog",
    "!/blog/**",
    "!/aviso-legal",
    "!/privacidad",
    "!/cookies"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/icons/favicon.ico",
          "/icons/favicon-96x96.png",
          "/icons/apple-touch-icon.png",
          "/index.csr.html",
          "/app.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "leaflet-tiles",
      "urls": ["https://*.tile.openstreetmap.org/**"],
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "30d",
        "timeout": "10s",
        "strategy": "performance"
      }
    }
  ]
}
