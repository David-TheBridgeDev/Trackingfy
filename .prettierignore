# Everything Prettier should keep its hands off.
#
# Without this file a bare `prettier .` walks into android/app/build and dist and spends
# minutes rewriting compiled output, which is why the formatter was never usable here.

# Build output and caches
dist/
.angular/
node_modules/
tmp/
out-tsc/

# Native shells: Capacitor owns these and regenerates them on `cap sync`. Reformatting
# them only creates a diff that the next sync throws away.
android/
ios/

# Generated by the package manager, and far too large to be worth rewriting.
package-lock.json

# Served verbatim: the Google site-verification file has to stay byte for byte as issued,
# and the rest of this folder is icons and binaries.
public/

# The site's HTML, but not its JavaScript or CSS.
#
# These pages are templates for site/build.js, not plain HTML: they carry {{variable}},
# {{> partial}} and {{icon name "classes"}}. Prettier's HTML parser does not know the
# syntax, breaks a placeholder across two lines and, on site/pages/index.html, never
# settles -- each run adds another eight blank lines, so `format:check` could never pass.
site/**/*.html
